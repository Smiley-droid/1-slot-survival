# Macro : slot -> place la barrière « LOCKED SLOT » (traduite côté client, voir assets/slot_survival/lang) (format composants 1.21.5+ / 1.21.11 / 26.x)
# "return run" renvoie 1 si réussi.
$return run item replace entity @s $(slot) with minecraft:barrier[minecraft:custom_data={slot_lock:1b},minecraft:custom_name={translate:"slot_survival.barrier.name",fallback:"LOCKED SLOT",color:"red",bold:true,italic:false},minecraft:lore=[{translate:"slot_survival.barrier.lore",fallback:"This slot is locked!",color:"gray",italic:false}],minecraft:max_stack_size=1,minecraft:enchantments={"minecraft:vanishing_curse":1},minecraft:tooltip_display={hidden_components:["minecraft:enchantments"]},minecraft:enchantment_glint_override=false]
